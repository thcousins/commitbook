{
  "name": "commitbook",
  "version": "0.4.0",
  "description": "A notebook app that keeps every note as a Markdown file in your own GitHub repo, with inline spreadsheets, tags, folders and full revision history.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "hyperformula": "3.5.0",
    "jspreadsheet-ce": "5.0.4",
    "jsuites": "^5.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.3"
  }
}
